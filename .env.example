# Thinair settings. Copy to `.env` (or run `thinair init`). Every value is optional; the defaults
# suit a single-user install on a small VM.

# --- Access --------------------------------------------------------------------------------
# Admin token you log in with (>= 20 chars, e.g. `openssl rand -hex 24`). If empty, one is
# generated on first start and printed once: `docker compose logs thinair | grep -A3 token`.
THINAIR_ADMIN_TOKEN=
# Host address/port the web UI is published on. 127.0.0.1 = this machine only: reach it from
# your phone through a tunnel (Tailscale, Cloudflare Tunnel) or the `https` profile below.
THINAIR_BIND=127.0.0.1
THINAIR_PORT=8080
# Public hostname for automatic HTTPS with `docker compose --profile https up -d`. Needed to
# install the app on a phone without a tunnel. Point the domain's DNS at this server first.
THINAIR_DOMAIN=

# --- Jobs ----------------------------------------------------------------------------------
# How many jobs run at once. Keep 1 on VMs with <= 4 GB RAM: each job runs its own containers.
THINAIR_MAX_CONCURRENT_JOBS=1
# Time limit for a whole job (clone + install + all test runs, or one agent run), in seconds.
THINAIR_JOB_TIMEOUT_S=3600
THINAIR_LOG_LEVEL=info

# --- Restricted networks -------------------------------------------------------------------
# Package mirrors used while installing a project's dependencies inside the sandbox (and the
# pip mirror also while building Thinair's own image). Leave empty to use pypi.org / npmjs.org.
THINAIR_PIP_INDEX_URL=
THINAIR_NPM_REGISTRY=

# --- Private GitHub repositories (optional) -----------------------------------------------
# A fine-grained token with "Contents: Read-only" on the repos you want. Used only by the clone
# container; never stored, logged, or given to install/test/agent runs. Or point
# THINAIR_GITHUB_TOKEN_FILE at a file that holds it.
THINAIR_GITHUB_TOKEN=
THINAIR_GITHUB_TOKEN_FILE=
# To open pull requests from agent tasks the token also needs "Contents: Read and write" and
# "Pull requests: Read and write". Commit author for those PRs:
THINAIR_GIT_AUTHOR_NAME=Thinair
THINAIR_GIT_AUTHOR_EMAIL=thinair@localhost

# --- Agent network ----------------------------------------------------------------------
# Agents whose config lists `egress` hosts (Claude Code) reach only those, through a per-run
# proxy. Set to "open" to turn this off. Extra hosts for every agent (comma-separated), e.g.
# registry.npmjs.org,pypi.org,files.pythonhosted.org if tasks should install packages.
THINAIR_AGENT_EGRESS=allowlist
THINAIR_AGENT_EGRESS_EXTRA_HOSTS=

# --- Notifications (optional) -----------------------------------------------------------
# Telegram message when a job finishes. Create a bot with @BotFather; the chat id is in
# https://api.telegram.org/bot<token>/getUpdates after you message the bot. Test: thinair notify-test
THINAIR_TELEGRAM_BOT_TOKEN=
THINAIR_TELEGRAM_CHAT_ID=
# Where you open Thinair (adds a link to each message), e.g. https://thinair.example.com
THINAIR_PUBLIC_URL=

# --- Coding agents (optional) --------------------------------------------------------------
# Usually you log an agent in once with `thinair auth claude`, and the login stays in its own
# Docker volume. Alternatively, paste a token you generated yourself with `claude setup-token`.
# It is passed only into Claude Code's sandbox and masked in all logs. Use your own account only.
CLAUDE_CODE_OAUTH_TOKEN=
# Codex / Gemini CLI alternatives to `thinair auth codex|gemini` (your own keys only):
CODEX_API_KEY=
GEMINI_API_KEY=
